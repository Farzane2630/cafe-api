{
   "version": 2,
   "builds": [
     {
       "src": "server.js",
       "use": "@vercel/node",
       "config": {
         "includeFiles": ["db.json"]
       }
     }
   ],
   "routes": [
     {
       "src": "/(.*)",
       "dest": "server.js"
     }
   ],
   "public": true,
   "functions": {
    "api/*": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
 }
